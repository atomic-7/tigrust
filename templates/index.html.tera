<!DOCTYPE html>
<html lang="en">
	<head>
		<title>Tigrust</title>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="stylesheet" type="text/css" href="/static/css/styles.css">
	</head>
	<body>
		<div class="infobar">
			<div class="infobar-item">
			</div>
			<div class="infobar-item">
			</div>
			<div class="infobar-item">
				<div class="switcher-bar">
					<form name="content-select" target="SiteContent">
						<button formaction="graph/today">Heute</button>
						<button formaction="graph/tomorrow">Morgen</button>
					</form>
				</div>
			</div>
		</div>
		<hr />
		<div class="site-content">
			<iframe src="graph/today" id="display" scrolling="no" frameborder="0" name="SiteContent">
		</div>
	</body>
</html>
