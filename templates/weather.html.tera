<!DOCTYPE html>
<html lang="en">
	<head>
		<title>Weather</title>
		<meta charset="UTF-8">
		<meta http-equiv="refresh" content="{{ refresh_rate }}">
		<link rel="stylesheet" type="text/css" href="/static/css/weather.css">
	</head>
	<body>
		<div id="forecast-today">
			{% for section in day_sections %}
			<div class="day-section">
				<div class="wc-icon">{{section.icon}}</div>
				<p>{{section.temperature | round(precision=1)}}°C</p>
				<p>{{section.rain_percent | round(precision=1)}}%</p>
			</div>
			{% endfor %}
		</div>
		<hr>
		<div id="forecasts">
			{% for day in days %}
			<div id="day.name" class="forecast-small">
				<div class="wc-icon">{{day.icon}}</div>
				<p>{{day.min_temp | round(precision=1)}}°C - {{day.max_temp | round(precision=1)}}°C</p>
				<p>{{day.sun_hours}}<span>*</span></p>
				<p>{{day.rain_percent | round(precision=1)}}<span>%</span></p>
			</div>
			{% endfor %}
		</div>
	</body>
</html>
