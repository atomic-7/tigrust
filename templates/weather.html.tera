<!DOCTYPE html>
<html lang="en">
	<head>
		<title>Weather</title>
		<meta charset="UTF-8">
		<meta http-equiv="refresh" content="{{ refresh_rate }}">
		<link rel="stylesheet" type="text/css" href="/static/css/weather.css">
	</head>
	<body>
		<div id="forecast-today">
			{% for section in day_sections %}
			<div class="day-section">
				<p>{{ loop.index0 * 3 }}</p>
				<div class="wc-icon">{{ section.icon | safe }}</div>
				<p>{{ section.temperature | round(precision=1) }}°C</p>
				<p>{{ section.rain_sum | round(precision=1) }} mm</p>
			</div>
			{% endfor %}
		</div>
		<hr>
		<div id="forecasts">
			{% for day in days %}
			<div id="day.name" class="forecast-small">
				<div class="wc-icon">{{ day.icon | safe }}</div>
				<p><span>{{ day.min_temp | round(precision=1) }}°C - {{ day.max_temp | round(precision=1) }}°C</span> | 
				<span>{{ day.sun_hours | round(precision=1) }}h</span> | 
				<span>{{ day.rain_sum | round(precision=1) }} mm</span></p>
			</div>
			{% endfor %}
		</div>
	</body>
</html>
